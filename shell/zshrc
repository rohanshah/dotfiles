# zsh configuration. zsh is the login shell on macOS.
# Anything shared with bash belongs in shell/common.sh, not here.

. "$HOME/dotfiles/shell/common.sh"

##### History #####

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt HIST_IGNORE_ALL_DUPS   # drop older duplicates of a repeated command
setopt HIST_IGNORE_SPACE      # skip commands that start with a space
setopt HIST_REDUCE_BLANKS     # tidy whitespace before storing
setopt SHARE_HISTORY          # share history across concurrent shells

##### Completion #####

# Docker's completions must be on fpath before compinit runs.
[ -d "$HOME/.docker/completions" ] && fpath=("$HOME/.docker/completions" $fpath)

# compinit runs exactly once. It used to run twice (once here, once from the
# block Docker Desktop appended), which roughly doubled shell startup time.
autoload -Uz compinit && compinit

##### Prompt #####

PS1='$ '

##### Must stay last #####

. "$DOTFILES/shell/sdkman.sh"
